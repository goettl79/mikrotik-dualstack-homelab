#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# 1. Leak Prevention Safeguard
# Ensure no unencrypted local files or secret keys are accidentally staged (ignore deletions)
STAGED_FILES=$(git diff --cached --diff-filter=d --name-only)

FORBIDDEN_PATTERNS=(
    "inventory.yaml"
    "setup.rsc"
    "setup.local.rsc"
    ".local"
    "keys.txt"
)

for file in $STAGED_FILES; do
    for pattern in "${FORBIDDEN_PATTERNS[@]}"; do
        if [[ "$file" == *"$pattern"* ]]; then
            echo -e "\033[0;31m[ERROR] Security check failed: Staging unencrypted file '$file' is strictly forbidden!\033[0m" >&2
            echo "Please unstage this file using: git restore --staged $file" >&2
            exit 1
        fi
    done
done

# 2. Auto-encrypt inventory.yaml -> inventory.enc.yaml if changed
if [[ -f "${REPO_ROOT}/inventory.yaml" ]]; then
    NEEDS_ENCRYPT=false
    if [[ ! -f "${REPO_ROOT}/inventory.enc.yaml" ]]; then
        NEEDS_ENCRYPT=true
    else
        # Compare local plaintext with decrypted content of inventory.enc.yaml
        if ! cmp -s "${REPO_ROOT}/inventory.yaml" <(sops -d "${REPO_ROOT}/inventory.enc.yaml" 2>/dev/null); then
            NEEDS_ENCRYPT=true
        fi
    fi

    if [[ "$NEEDS_ENCRYPT" == true ]]; then
        echo "[pre-commit] Local inventory.yaml changed. Auto-encrypting -> inventory.enc.yaml..."
        sops -e "${REPO_ROOT}/inventory.yaml" > "${REPO_ROOT}/inventory.enc.yaml"
        git add "${REPO_ROOT}/inventory.enc.yaml"
    fi
fi

# 3. Auto-encrypt setup.rsc -> setup.enc.rsc if changed
if [[ -f "${REPO_ROOT}/setup.rsc" ]]; then
    NEEDS_ENCRYPT=false
    if [[ ! -f "${REPO_ROOT}/setup.enc.rsc" ]]; then
        NEEDS_ENCRYPT=true
    else
        # Compare local plaintext with decrypted content of setup.enc.rsc
        if ! cmp -s "${REPO_ROOT}/setup.rsc" <(sops -d --input-type binary --output-type binary "${REPO_ROOT}/setup.enc.rsc" 2>/dev/null); then
            NEEDS_ENCRYPT=true
        fi
    fi

    if [[ "$NEEDS_ENCRYPT" == true ]]; then
        echo "[pre-commit] Local setup.rsc changed. Auto-encrypting -> setup.enc.rsc..."
        sops -e --input-type binary --output-type binary "${REPO_ROOT}/setup.rsc" > "${REPO_ROOT}/setup.enc.rsc"
        git add "${REPO_ROOT}/setup.enc.rsc"
    fi
fi
